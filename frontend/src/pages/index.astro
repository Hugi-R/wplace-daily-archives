---
// src/pages/index.astro
// Root route: redirect to the locale that best matches the browser language,
// falling back to English. Detection runs client-side so it works under a
// static build (no per-request Accept-Language handling available).
import * as m from '../paraglide/messages.js';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{m.page_title()}</title>
    <!-- Fallback redirect for crawlers / no-JS clients -->
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://wplace.eralyon.net/en/" />
  </head>
  <body>
    <script is:inline>
      (function () {
        const supported = ['en', 'es', 'pt', 'ja'];
        const langs = navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language];
        let best = 'en';
        for (const lang of langs) {
          const lower = String(lang).toLowerCase();
          const base = lower.split('-')[0];
          if (supported.includes(base)) {
            best = base;
            break;
          }
        }
        // Preserve any query string the visitor arrived with.
        const qs = window.location.search || '';
        window.location.replace('/' + best + '/' + qs);
      })();
    </script>
    <noscript>
      <a href="/en/">{m.continue_link()}</a>
    </noscript>
  </body>
</html>
