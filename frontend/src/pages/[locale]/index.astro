---
// src/pages/[locale]/index.astro
import '../../styles/global.css';
import * as m from '../../paraglide/messages.js';
import { languageTag } from '../../paraglide/runtime.js';
import Encart from '../../components/Encart.astro';
import MapMount from '../../islands/MapMount.svelte';
import TileOverlay from '../../islands/TileOverlay.svelte';
import VersionSlider from '../../islands/VersionSlider.svelte';
import LayerSelector from '../../islands/LayerSelector.svelte';
import CoordForm from '../../islands/CoordForm.svelte';
import ContextMenu from '../../islands/ContextMenu.svelte';
import VideoConfig from '../../islands/VideoConfig.svelte';
import StatsPanel from '../../islands/StatsPanel.svelte';
import TransparencyToggle from '../../islands/TransparencyToggle.svelte';
import ZoomButtons from '../../islands/ZoomButtons.svelte';
import DevModeToggle from '../../islands/DevModeToggle.svelte';

export function getStaticPaths() {
  return [
    { params: { locale: 'en' } },
    { params: { locale: 'es' } },
    { params: { locale: 'pt' } },
    { params: { locale: 'ja' } },
  ];
}
---

<html lang={languageTag()}>
  <head>
    <meta charset="utf-8" />
    <title>{m.page_title()}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={m.meta_description()} />
    <!-- hreflang tags -->
    <link rel="alternate" hreflang="en" href="https://wplace.eralyon.net/en/" />
    <link rel="alternate" hreflang="es" href="https://wplace.eralyon.net/es/" />
    <link rel="alternate" hreflang="pt" href="https://wplace.eralyon.net/pt/" />
    <link rel="alternate" hreflang="ja" href="https://wplace.eralyon.net/ja/" />
    <!-- Open Graph -->
    <meta property="og:title" content={m.page_title()} />
    <meta property="og:description" content={m.meta_description()} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://wplace.eralyon.net/" />
    <meta property="og:image" content="/preview.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <main>
      <div id="map-wrapper" style="position:relative;">
        <MapMount client:only="svelte" />
        <TileOverlay client:only="svelte" />
      </div>
    </main>

    <VersionSlider client:only="svelte" />

    <div id="extra" style="position:absolute; top:60px; left:10px; z-index:3; display:flex; flex-direction:column; gap:10px; align-items:flex-start;">
      <Encart />
      <DevModeToggle client:only="svelte" />
      <LayerSelector client:only="svelte" />
      <CoordForm client:only="svelte" />
      <ContextMenu client:only="svelte" />
      <VideoConfig client:only="svelte" />
      <StatsPanel client:only="svelte" />
    </div>

    <ZoomButtons client:only="svelte" />
    <TransparencyToggle client:only="svelte" />

    <!-- Escape hotkey toggles UI chrome visibility (map stays visible) -->
    <script>
      import { uiVisible } from '../../state/stores';
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          uiVisible.set(!uiVisible.get());
        }
      });
    </script>
  </body>
</html>
