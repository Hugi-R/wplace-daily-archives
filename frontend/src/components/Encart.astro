---
// src/components/Encart.astro
// Static HTML panel with a close button (zero JS framework dependency)
import * as m from '../paraglide/messages.js';
---

<div id="encart">
  <button id="encart-close" aria-label={m.close_encart()} title={m.close_encart()}>&times;</button>
  <div id="encart-content">
    <p>{m.encart_test_server()}</p>
    <p><a href="https://wplace.eralyon.net">{m.back_to_stable()}</a></p>
  </div>
</div>

<style>
  #encart {
    position: relative;
    z-index: 20;
    background: var(--panel-bg);
    border-radius: 4px;
    box-shadow: var(--shadow-lg);
    padding: 10px 24px 10px 16px;
    font-size: 16px;
    min-width: 220px;
    max-width: 320px;
    border: 1px solid var(--border-color);
    align-self: flex-start;
  }

  #encart-close {
    position: absolute;
    top: 6px;
    right: 10px;
    cursor: pointer;
    font-size: 18px;
    color: var(--muted-text);
    transition: color 0.2s;
    background: transparent;
    border: none;
    padding: 0;
    line-height: 1;
    appearance: none;
  }

  #encart-close:hover {
    color: var(--muted-text-strong);
  }

  #encart-content {
    margin-top: 2px;
    margin-right: 18px;
  }
</style>

<script>
  const closeBtn = document.getElementById('encart-close');
  const encart = document.getElementById('encart');
  closeBtn?.addEventListener('click', () => {
    encart?.style.setProperty('display', 'none');
  });
</script>
